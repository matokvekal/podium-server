# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
# NOTE: a bare `env.ts` used to be ignored here (another leftover from the same
# scaffold as the `/tests/` note below). It silently excluded src/config/env.ts —
# the env schema every module imports — so a fresh clone could not build. Secrets
# live in `.env`, which is ignored further down; env.ts itself is source.

# testing
/coverage

# next.js
/.next/
/out/
# NOTE: `/tests/` used to be ignored here (leftover from a Next.js scaffold —
# this is a Vite app). That silently excluded the whole Playwright E2E suite
# from version control. Test SOURCES are tracked; only their OUTPUT is ignored.
test-results
playwright-report
test-examples
# production
/build
/dist
.env.local
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

