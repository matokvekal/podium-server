{
  "name": "commissaire-server",
  "version": "0.2.0",
  "description": "Commissaire API: Google/SMS-authenticated backend for the Commissaire app and the Transmiter Android app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "tsx watch --inspect=9229 src/server.ts",
    "dev:all": "npm run db:up && npm run dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/server.js",
    "serve": "node dist/server.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --build --wait db",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker exec -it podium-db psql -U podium -d podium",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Gilad Dolev",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "jose": "^6.2.8",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
