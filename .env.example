# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=6500

# Postgres connection string. The value below matches docker-compose.yml —
# `docker compose up -d db` gives you exactly this database, with the schema
# from sql/ already applied. See README.md > Database in Docker.
# For any other database, the schema is created by hand from sql/ — nothing
# applies it automatically.
# The server boots and /health works without this variable at all; only
# DB-backed auth flows (Google/SMS sign-in, sessions, /users/me) need it.
DATABASE_URL=postgresql://podium:podium@localhost:5432/podium

# --- Commissaire session tokens ---
# JWT_ACCESS_SECRET signs the short-lived access token. Required in production (min 32
# characters). In development/test, if unset, an insecure built-in default is used
# automatically — fine for local work, never acceptable in production (the server refuses
# to start in production without a real value).
# Refresh tokens are NOT JWTs — they're opaque cryptographically-random values, and only a
# sha256 hash of one is ever stored (in `sessions.refresh_token_hash`), so there's no
# JWT_REFRESH_SECRET to configure.
# JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google sign-in ---
# Comma-separated OAuth client IDs the server accepts as a valid Google ID
# token audience. Create these in Google Cloud Console > APIs & Services >
# Credentials. The Android app should request an ID token using a "Web
# application" client ID as its serverClientId so its tokens are audienced
# to that same ID; add a separate one here if the web dashboard signs in
# with its own client. See SETUP.md.
GOOGLE_CLIENT_IDS=

# --- SMS sign-in ---
# MOCK (default) logs the OTP code locally for dev/test — no real SMS is sent.
# TWILIO is not implemented yet (see src/modules/sms/sms-provider.ts).
SMS_PROVIDER=MOCK

# --- Which auth providers are live ---
# Comma-separated. Controls both GET /api/v1/auth/config (what clients should show
# on the login screen) and whether each provider's endpoints accept requests at all.
# Defaults to GOOGLE if unset.
AUTH_PROVIDERS=GOOGLE,SMS

# --- ⚠ TEMPORARY: developer sign-in — DELETE BEFORE PRODUCTION ---
# Enables POST /api/v1/auth/dev-login, which signs in as a fake user with NO credential of
# any kind and issues a real session. It exists so the web client can be developed without a
# Google client id or a real phone.
# Defaults to on outside production and is FORCED off when NODE_ENV=production. Set it to
# false to switch it off in development too.
# Removal checklist: README.md > Developer sign-in.
DEV_LOGIN_ENABLED=true

# Comma-separated allowed origins for the web dashboard (native apps don't
# send an Origin header, so the Android app doesn't need an entry here).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# --- Retention ---
# How long raw GPS points are kept after an event finishes. Only location_points are ever
# deleted, and never before that event's participant_tracks have been written.
LOCATION_RETENTION_DAYS=30
